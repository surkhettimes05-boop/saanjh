# Public site identity. Required for a production Vercel deployment.
NEXT_PUBLIC_SITE_URL=

# Configure at least one real contact channel before production launch.
NEXT_PUBLIC_PHONE=
NEXT_PUBLIC_WHATSAPP=
NEXT_PUBLIC_EMAIL=
NEXT_PUBLIC_LOCATION=

NEXT_PUBLIC_FACEBOOK=
NEXT_PUBLIC_INSTAGRAM=

# Optional external retailer inquiry receiver (Formspree/custom API/etc.).
NEXT_PUBLIC_INQUIRY_ENDPOINT=

# Optional integrations. Tracking scripts are intentionally not loaded until
# consent/privacy handling is implemented.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Set true on non-Vercel production hosts to enforce the same production checks.
SAANJH_REQUIRE_CONFIG=false
